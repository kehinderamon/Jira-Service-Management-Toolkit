# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file — it's already excluded in .gitignore.

# Your Jira site URL (no trailing slash), e.g. https://yourcompany.atlassian.net
JIRA_SITE_URL=https://yourcompany.atlassian.net

# The email address of your Atlassian account
JIRA_EMAIL=you@example.com

# An API token generated at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_api_token_here

# The project key of your Jira Service Management project (visible in ticket
# keys, e.g. "ITSD" in ITSD-42, or "HELP" in HELP-7). Found under
# Project settings -> Details in Jira.
JIRA_PROJECT_KEY=ITSD
